# .zshrc.local — machine-local shell config
#
# This file is sourced at the end of ~/.zshrc. It is intentionally NOT tracked
# by the dotfiles repo so each machine can keep its own tool bootstrapping,
# secrets, and path tweaks without polluting the shared config.
#
# Copy this file to ~/.zshrc.local and uncomment the blocks you need.

# --- rustup (Homebrew, keg-only) -------------------------------------------
# if [ -d /opt/homebrew/opt/rustup/bin ]; then
#   export PATH="/opt/homebrew/opt/rustup/bin:$PATH"
# fi

# --- bun -------------------------------------------------------------------
# if [ -d "$HOME/.bun" ]; then
#   export BUN_INSTALL="$HOME/.bun"
#   export PATH="$BUN_INSTALL/bin:$PATH"
#   [ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"
# fi

# --- nvm -------------------------------------------------------------------
# export NVM_DIR="$HOME/.nvm"
# [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
# [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# --- Homebrew (Apple Silicon) ---------------------------------------------
# if [ -x /opt/homebrew/bin/brew ]; then
#   eval "$(/opt/homebrew/bin/brew shellenv)"
# fi

# --- Homebrew (Linuxbrew) --------------------------------------------------
# if [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
#   eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
# fi

# --- Secrets / API keys ----------------------------------------------------
# export ANTHROPIC_API_KEY="..."
# export OPENAI_API_KEY="..."

# --- go toolchain ----------------------------------------------------------
# if command -v go >/dev/null 2>&1; then
#   export PATH="$(go env GOPATH)/bin:$PATH"
# fi

# --- remote hosts ----------------------------------------------------------
# Host-specific aliases belong here, not in the tracked .zshrc — hostnames on
# a private network are neither portable nor safe to publish.
# alias myhost='mosh --server=/opt/homebrew/bin/mosh-server myhost -- \
#   /opt/homebrew/bin/tmux new-session -A -D -s 0'
